# ============================================================================
# RESTROZ SAAS — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.development for DEV or .env.production for PROD
# ============================================================================

# Application Environment: 'development' or 'production'
EXPO_PUBLIC_APP_ENV=development

# Supabase Project API URL & Public Anon Key
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-publishable-anon-key>

# App / Web Frontend URL (http://localhost:8081 for dev, https://restroz.shop for prod)
EXPO_PUBLIC_APP_URL=http://localhost:8081
